{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grapevine-prep",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "grapevine-prep"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "RIG_DOWNLOADS",
      "bucket_name": "grapevine-rig-downloads"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://grapevineprep.com/api/auth/google/callback",
    "PP_UNAVAILABLE_ON_HOSTED": "true"
  },
  "routes": [
    {
      "pattern": "grapevineprep.com",
      "custom_domain": true
    },
    {
      "pattern": "www.grapevineprep.com",
      "custom_domain": true
    }
  ]
}
