{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default Grapevine Rig capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "zsh-login",
          "cmd": "/bin/zsh",
          "args": ["-l", "-c", { "validator": ".+" }]
        },
        {
          "name": "system-node",
          "cmd": "/usr/local/bin/node",
          "args": true
        },
        {
          "name": "homebrew-node",
          "cmd": "/opt/homebrew/bin/node",
          "args": true
        },
        {
          "name": "usr-node",
          "cmd": "/usr/bin/node",
          "args": true
        },
        {
          "name": "windows-node",
          "cmd": "node.exe",
          "args": true
        },
        {
          "name": "windows-node-plain",
          "cmd": "node",
          "args": true
        },
        {
          "name": "osascript-export",
          "cmd": "/usr/bin/osascript",
          "args": true
        }
      ]
    }
  ]
}
