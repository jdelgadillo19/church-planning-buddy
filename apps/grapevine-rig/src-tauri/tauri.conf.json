{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grapevine Rig",
  "version": "0.1.0",
  "identifier": "com.grapevineprep.rig",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grapevine Rig",
        "width": 420,
        "height": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://grapevineprep.com https://*.grapevineprep.com; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["bin/grapevine-rig-worker", "bin/grapevine-rig-scan"],
    "resources": ["resources/worker.mjs", "resources/scan.mjs"]
  }
}
