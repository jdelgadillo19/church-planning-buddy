{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grapevine Client",
  "version": "0.2.16",
  "identifier": "com.grapevineprep.rig",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grapevine Client",
        "width": 420,
        "height": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://grapevineprep.com https://*.grapevineprep.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/worker.mjs": "worker.mjs",
      "resources/scan.mjs": "scan.mjs",
      "resources/handoff.mjs": "handoff.mjs",
      "resources/remote-prep.mjs": "remote-prep.mjs",
      "resources/export-playlist.applescript": "export-playlist.applescript",
      "resources/open-propresenter.applescript": "open-propresenter.applescript"
    }
  }
}
