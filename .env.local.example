## Local development environment variables.
## Copy this file to `.env.local` and fill values in.

## Grapevine Prep auth (dedicated Supabase project — not Gojito)
# When both are set, middleware requires sign-in + org_members row before any tool route.
# Leave unset for local-only dev without Supabase (middleware bypassed).
# Supabase Dashboard → Auth → URL Configuration: Site URL https://grapevineprep.com
# and redirect URLs including /auth/callback (see docs/HOSTING-GRAPEVINE.md).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_GRAPEVINE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only (never NEXT_PUBLIC): use service_role / sb_secret — NOT the anon line above
SUPABASE_SERVICE_ROLE_KEY=

## Planning Center (read + write for PDF upload to "Get Ready Guide" plan item)
# Personal Access Token or basic auth must include Services write and file upload permissions.
PCO_BASIC_TOKEN=
# PCO_ACCESS_TOKEN=
# GRG plan picker scope. First choice is current PCO user's primary campus; set this when
# People profile access is unavailable or you want an explicit campus override.
PCO_PLAN_SCOPE_CAMPUS_NAME=Berlin

## GRG Drive folders (church-planning-buddy/Get Ready Guide/Template and .../Output)
# M0 re-point: resolve under new layout root — see docs/planning/m0-drive-repoint.md
# GV_DRIVE_LAYOUT_ROOT_FOLDER_ID=1FG1w8LXfoSTQfjKZxsAv7735F0IukvMw
# Legacy sync DB (read-only reference, do NOT write): 1-1I9HY7af_a2FCRw8WmKceAuI50DLJlg
# Prefer folder IDs — stable if folders are renamed. Run:
#   npx tsx scripts/resolve-grapevine-drive-layout.ts --parent 1FG1w8LXfoSTQfjKZxsAv7735F0IukvMw
GRG_TEMPLATE_FOLDER_ID=1iKjKFBPKI8GGpvKxUtxeQP60HUNaHoYK
GRG_OUTPUT_FOLDER_ID=17D1Ok8CqHZo3ay2nBvck7zcW2TTHBgYn
GRG_TEMPLATE_FOLDER_PATH=church-planning-buddy/Get Ready Guide/Template
GRG_OUTPUT_FOLDER_PATH=church-planning-buddy/Get Ready Guide/Output
# Optional path segments (used when *_FOLDER_PATH is unset):
# GRG_DRIVE_ROOT=church-planning-buddy
# GRG_GUIDE_FOLDER=Get Ready Guide
# GRG_TEMPLATE_SUBFOLDER=Template
# GRG_OUTPUT_SUBFOLDER=Output

## GRG template (never modified by the app — must include placeholders, see docs/GRG-TEMPLATE.md)
GRG_TEMPLATE_TITLE=Get Ready Guide (TEMPLATE)
GRG_TEMPLATE_ID=1K8pKDhHPbGj9GLPvFF2Waa-VRaqpT2xm4iGb_GK1ebQ

## GRG output (recreated from template on each Approve)
# {{GRG_DATE}} is replaced with plan date as YYYY.MM.DD (e.g. Get Ready Guide 2026.05.24)
GRG_OUTPUT_TITLE=Get Ready Guide {{GRG_DATE}}

## Roster (optional)
# MVP: confirmed members on Platform Team with BAND-/CHOIR-/Guests positions (default team: Platform Team)
# GRG_ROSTER_TEAM_NAMES=Platform Team,BAND,CHOIR,ALL TEAM
# Comma-separated PCO team IDs — overrides team names when set
# GRG_ROSTER_TEAM_IDS=
# Path to PCO position → template label map (default: docs/roster-position-map.json)
# GRG_ROSTER_POSITION_MAP=

## Google OAuth — reconnect after scope change (Drive, Docs, Sheets read, Calendar events)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

## Team Messaging (Google Sheet + Calendar + WhatsApp on messaging Mac)
MESSAGING_SHEET_ID=11zECEZEwXiivZc8enMZq5APXp22DP17KwPaKrtcHsEU
MESSAGING_CALENDAR_ID=d1d5cdccf8bae2bb427b3b3d181642f9c75654b2d750c24c881d38aff0c77d12@group.calendar.google.com
MESSAGING_ALERT_GROUP=TestGroup
# Draft-forward: send prepared text to your phone (headless schedule)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# MESSAGING_OWNER_PHONE_E164=49xxxxxxxxxx
# Optional webhook (Pushcut etc.)
# MESSAGING_DRAFT_WEBHOOK_URL=
# PCO owner for away context (default Jesse)
PCO_OWNER_PERSON_ID=AC114173152
# Prefer setting the service type directly; used to list upcoming plans by date in GRG setup.
PCO_SERVICE_TYPE_ID=
# Optional fallback used only to resolve service type when PCO_SERVICE_TYPE_ID is blank.
# PCO_DEFAULT_PLAN_ID=
# Set true on messaging Mac only when ready for unattended send from CLI
# MESSAGING_ALLOW_SEND=false
# Future: stage layout Slides → PNG for GRG
# STAGE_LAYOUT_PRESENTATION_ID=1EviAKrc_Y9UDytFxa2esWBMKgk7gm2xiK3Zoatl1EWI

## ProPresenter 21.3 Local API (operator Mac — ProPresenter must be running)
# ProPresenter often shows TWO ports in Settings → Network:
#   • "Port" on the main network line (e.g. 64496) — may be HTTP / Remote
#   • TCP/IP "Port ID" (e.g. 64509) — TCP JSON API (what npm run pp:diagnose usually needs)
# If diagnose shows TCP ✓ on PP_PORT but HTTP ✗ with HPE_INVALID, use PP_TRANSPORT=tcp.
# Slide Deck Mac agent — DEBUG ONLY (deprecated for operators). Same value on Worker secret.
# SLIDE_DECK_AGENT_TOKEN=
# GRAPEVINE_PREP_URL=https://grapevineprep.com

# ProPresenter bundle scanner (Grapevine Rig / pp:bundle-scan)
# PP_BUNDLE_ROOT=/Users/you/Library/Application Support/RenewedVision/ProPresenter
# PP_DEVICE_LABEL=main-sanctuary-mac
# Org UUID from Supabase organizations table (for pp:index-upload)
# PP_PLATFORM_ORG_ID=a26ad903-6820-4093-a7d6-ab92fc62ce26
# PP_RIG_DISPLAY_NAME=Main sanctuary Mac

PP_HOST=127.0.0.1
PP_PORT=64509
# Cloudflare Workers only — blocks PP API routes on grapevineprep.com (do not set locally).
# PP_UNAVAILABLE_ON_HOSTED=true
# Support Files root (Preferences → Advanced) — sync/diff only, not Drive publish
# PP_SUPPORT_FILES_PATH=/Users/SBBWD/Documents/ProPresenter
# Staging folder for automated File → Export → Playlist during Publish (optional)
# PP_EXPORT_STAGING_DIR=.data/pp-exports
# Optional: Network-tab port, for diagnose to compare (e.g. 64496)
# PP_NETWORK_PORT=64496
PP_TRANSPORT=tcp
PP_HTTPS=false
PP_REQUEST_TIMEOUT_MS=10000
# Read-only by default. Set true for remote prep / dev: build playlist into local ProPresenter (Download).
PP_ALLOW_WRITES=false
# Optional engineering flag — not required for prep volunteers (local apply uses PP_ALLOW_WRITES only).
# PP_DEV_APPLY=true
# PUT playlist contents can take 30–90s on large libraries
# PP_APPLY_TIMEOUT_MS=120000
# Poll until live playlist matches commit preview (default 30000ms, interval 500ms)
# PP_APPLY_VERIFY_MS=30000
# PP_APPLY_POLL_MS=500
# Skip unresolved songs instead of failing apply (dev only; default is fail-fast)
# PP_ALLOW_PARTIAL_APPLY=true

## ProPresenter Drive handoff (personal church-planning-buddy/ProPresenter/…)
# Playlists = slide deck packages per service; New Files = additive rig imports
# Resolve under layout root: npx tsx scripts/resolve-grapevine-drive-layout.ts --parent <layout-root-id>
PP_PLAYLISTS_FOLDER_ID=1RGVufowmgGWnOXGRCTDTFKvVaJVRt_3v
PP_NEW_FILES_FOLDER_ID=1V0hCt2pzji3RCAqn-H6TjY149QLrJQYx
PP_PLAYLISTS_FOLDER_PATH=church-planning-buddy/ProPresenter/Playlists
PP_NEW_FILES_FOLDER_PATH=church-planning-buddy/ProPresenter/New Files
# M3 Services packages + M2 Filebase (see docs/planning/filebase-migration-plan.md)
# GV_DRIVE_LAYOUT=legacy|dual|v1
# PP_SERVICES_FOLDER_ID=
# PP_SERVICES_FOLDER_PATH=Services
# Computer-backup filebase (legacy sync DB — librarian reads this for pulls):
# PP_COMPUTER_FILEBASE_FOLDER_ID=1-1I9HY7af_a2FCRw8WmKceAuI50DLJlg
# PP_FILEBASE_FOLDER_ID=
# PP_FILEBASE_FOLDER_PATH=Filebase
# Supabase auth user id for file librarian (Owner Google / sbblegacytech Connect Google):
# PP_LIBRARIAN_USER_ID=2f90300d-47b8-4456-83a1-2f6ccf4a3813
# Run: npx tsx scripts/resolve-grapevine-drive-layout.ts (or legacy resolve-pp-folder-ids.ts from Drive root)

## Slide Deck Generator
PP_TEMPLATE_PLAYLIST_NAME=Sundays Template
# PP_PLAYLIST_NAME_PREFIX=SUN
# Optional extra PCO title skips (comma-separated regex or substring)
# PP_SKIP_PCO_TITLE_PATTERNS=
# PP_SKIP_PCO_TITLE_EXACT=
