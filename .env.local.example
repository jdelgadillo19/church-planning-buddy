## Local development environment variables.
## Copy this file to `.env.local` and fill values in.

## Planning Center
PCO_BASIC_TOKEN=

## GRG template (never modified by the app — must include placeholders, see docs/GRG-TEMPLATE.md)
GRG_TEMPLATE_TITLE=Get Ready Guide (TEMPLATE)
# GRG_TEMPLATE_ID=

## GRG output (recreated from template on each Approve)
# {{GRG_DATE}} is replaced with plan date as YYYY.MM.DD (e.g. Get Ready Guide 2026.05.24)
GRG_OUTPUT_TITLE=Get Ready Guide {{GRG_DATE}}

## Roster (optional)
# MVP: confirmed members on Platform Team with BAND-/CHOIR-/Guests positions (default team: Platform Team)
# GRG_ROSTER_TEAM_NAMES=Platform Team,BAND,CHOIR,ALL TEAM
# Comma-separated PCO team IDs — overrides team names when set
# GRG_ROSTER_TEAM_IDS=
# Path to PCO position → template label map (default: docs/roster-position-map.json)
# GRG_ROSTER_POSITION_MAP=

## Google OAuth — reconnect after scope change (Drive + Docs write)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
