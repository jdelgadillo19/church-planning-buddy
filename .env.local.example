## Local development environment variables.
## Copy this file to `.env.local` and fill values in.

## Planning Center
PCO_BASIC_TOKEN=

## GRG template (never modified by the app — must include placeholders, see docs/GRG-TEMPLATE.md)
GRG_TEMPLATE_TITLE=Get Ready Guide (TEMPLATE)
# GRG_TEMPLATE_ID=

## GRG output (recreated from template on each Approve)
GRG_OUTPUT_TITLE=Get Ready Guide (Good Friday)
# Legacy alias for output title:
# GRG_DOC_TITLE=Get Ready Guide (Good Friday)

## Google OAuth — reconnect after scope change (Drive + Docs write)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
